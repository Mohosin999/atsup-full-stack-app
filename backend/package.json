    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "prisma": "^7.9.1",
