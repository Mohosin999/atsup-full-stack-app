generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(255)
  googleId     String?  @unique @db.VarChar(255)
  password     String?  @db.VarChar(255)
  picture      String?
  preferences  Json?
  subscription Json?
  createdAt    DateTime @default(now()) @db.Timestamp()
  updatedAt    DateTime @updatedAt @db.Timestamp()
  lastLoginAt   DateTime?   @db.Timestamp()
  role              String              @default("user")
  isBanned          Boolean             @default(false)
  isActive          Boolean             @default(true)
  lastActiveAt      DateTime?           @db.Timestamp()
  lastSeenSupportAt DateTime?           @db.Timestamp()
  lastSeenReviewsAt DateTime?           @db.Timestamp()

  @@index([role, isActive])

  resumes           Resume[]
  analyses          Analysis[]
  atsScores         AtsScore[]
  atsScoreHistories AtsScoreHistory[]
  jobDescriptions   JobDescription[]
  payments          Payment[]
  supportTickets    SupportTicket[]
  feedbacks         Feedback[]

  @@map("users")
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  sourceType     String   @default("uploaded") @db.VarChar(50)
  originalFormat Json?
  content        Json
  metadata       Json
  tags           String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamp()
  updatedAt      DateTime @updatedAt @db.Timestamp()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses  Analysis[]
  atsScores AtsScore[]

  @@index([userId, createdAt])
  @@map("resumes")
}

model Analysis {
  id                String   @id @default(cuid())
  userId            String
  resumeId          String
  jobDescription    String   @default("") @db.Text
  jobTitle          String?
  company           String?
  score             Int      @default(0)
  atsScore          Int      @default(0)
  atsBreakdown      Json?
  jobMatchingBreakdown Json?
  atsSuggestions    String[]
  jobMatchSuggestions String[]
  feedback          Json
  sectionScores     Json
  keywords          Json
  missingKeywords   Json
  recommendedKeywords String[]
  howToUseKeywords  String[]
  resumeImprovements String[]
  jobMatch           Json?
  existingSections  Json
  createdAt         DateTime @default(now()) @db.Timestamp()
  updatedAt         DateTime @updatedAt @db.Timestamp()

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("analyses")
}

model AtsScore {
  id           String   @id @default(cuid())
  userId       String
  resumeId     String
  overallScore Int      @db.Integer
  sectionScores Json
  atsFriendliness Int    @db.Integer
  suggestions  String[]
  createdAt    DateTime @default(now()) @db.Timestamp()
  updatedAt    DateTime @updatedAt @db.Timestamp()

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([resumeId])
  @@map("ats_scores")
}

model AtsScoreHistory {
  id               String   @id @default(cuid())
  userId           String
  title            String   @db.VarChar(255)
  resumeName       String   @db.VarChar(255)
  overallScore     Int      @db.Integer
  sectionScores    Json
  atsFriendliness  Int      @db.Integer
  suggestions      String[]
  resumeContent    Json
  aiResearch       Json?
  createdAt        DateTime @default(now()) @db.Timestamp()
  updatedAt        DateTime @updatedAt @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ats_score_histories")
}

model JobDescription {
  id          String   @id @default(cuid())
  userId      String
  description String   @db.Text
  createdAt   DateTime @default(now()) @db.Timestamp()
  updatedAt   DateTime @updatedAt @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("job_descriptions")
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  email             String   @db.VarChar(255)
  amount            Int
  currency          String   @default("usd") @db.VarChar(10)
  status            String   @default("pending") @db.VarChar(50)
  paymentMethod     String   @db.VarChar(50)
  planId            String   @db.VarChar(50)
  credits           Int
  stripeSessionId   String?  @unique @db.VarChar(255)
  bkashTransactionId String? @db.VarChar(255)
  createdAt         DateTime @default(now()) @db.Timestamp()
  updatedAt         DateTime @updatedAt @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payments")
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  type       String   @default("bug") @db.VarChar(50)
  title      String   @db.VarChar(255)
  message    String   @db.Text
  attachment String?
  status     String   @default("open") @db.VarChar(50)
  createdAt  DateTime @default(now()) @db.Timestamp()
  updatedAt  DateTime @updatedAt @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("support_tickets")
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String
  rating      Int      @db.Integer
  message     String   @db.Text
  showOnHome  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamp()
  updatedAt   DateTime @updatedAt @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("feedbacks")
}

model Visitor {
  id            String   @id @default(cuid())
  fingerprint   String
  ipAddress     String?
  userAgent     String?
  lastVisitAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([fingerprint])
  @@index([lastVisitAt])
  @@map("visitors")
}

model SiteStats {
  id                   String   @id @default("singleton")
  totalUniqueVisitors  Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@map("site_stats")
}
